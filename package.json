{
  "name": "playwright-allure-pom",
  "version": "1.0.0",
  "description": "Playwright + Allure + POM demo project",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "allure:generate": "allure generate ./allure-results --clean -o ./allure-report",
    "allure:open": "allure open ./allure-report",
    "test:pom": "playwright test --config=playwright.pom.config.ts",
    "test:qa:smoke": "playwright test --grep @smoke",
    "test:qa:failure": "playwright test --grep @failure"
  },
  "devDependencies": {
    "@playwright/test": "1.58.0",
    "allure-commandline": "^2.29.0",
    "allure-playwright": "^2.15.1",
    "typescript": "^5.7.3"
  }
}
